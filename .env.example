# =========================================================
# ⚡ SPARK AI — CONFIGURATION TEMPLATE
# =========================================================

# Nvidia NIM API Key (Security gate, evaluator, embeddings)
NVIDIA_API_KEY=your_nvidia_api_key

# Ollama Cloud API Key (Router & Workers: gemma4:31b, gpt-oss:120b)
OLLAMA_API_KEY=your_ollama_api_key
OLLAMA_BASE_URL=https://ollama.com/v1

# Google Gemini API Key (Planner, validator, coding worker)
GEMINI_API_KEY=your_gemini_api_key

# =========================================================
# TELEMETRY & TOOLS
# =========================================================
LANGCHAIN_TRACING_V2=false
ANONYMIZED_TELEMETRY=False
SEARXNG_URL=your_self_hosted_searxng_url

# =========================================================
# 🔭 LANGFUSE OBSERVABILITY & AGENT TRACING
# =========================================================
LANGFUSE_PUBLIC_KEY=your_langfuse_public_key
LANGFUSE_SECRET_KEY=your_langfuse_secret_key
LANGFUSE_HOST=https://cloud.langfuse.com

# =========================================================
# ⚡ LAYA SYSTEM ONE DECISION ENGINE (Dual-Brain / Dual-Process)
# =========================================================
LAYA_BASE_URL=your_self_hosted_laya_url
ENABLE_LAYA=true
LAYA_TIMEOUT_SECONDS=3.5
